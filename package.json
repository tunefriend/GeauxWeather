{
  "name": "geauxweather",
  "version": "1.0.9",
  "description": "GeauxWeather \u2014 clean, fast, no-ads weather for Android",
  "main": "index.js",
  "scripts": {
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "android": "npx cap sync android && cd android && ./gradlew assembleDebug",
